# Copy this file to backend/.env and fill in real values for local development.
# In production, these variables are injected by the deployment runtime — the
# .env file is not shipped.

# Postgres (matches docker-compose host port; see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ecommerce?sslmode=disable

# Redis (matches docker-compose).
REDIS_URL=redis://localhost:6379

# Service ports. Optional — defaults are 9000 (gRPC) and 8000 (HTTP).
GRPC_PORT=9000
HTTP_PORT=8000

# JWT signing secret (HS256). At least 32 characters. Required.
JWT_SECRET=replace-me-with-a-real-32-char-secret-or-longer

# Session token lifetime. Optional, defaults to 24h. Go duration syntax.
JWT_TTL=24h

# Catalog gRPC service address (default localhost:9000).
CATALOG_ADDR=localhost:9000

# Cart gRPC service listen port. Defaults to GRPC_PORT if unset, but locally
# use a distinct port so cart and catalog can both run. Suggested: 9001.
CART_GRPC_PORT=9001

# Cart gRPC service address (default localhost:9001 — matches CART_GRPC_PORT).
CART_ADDR=localhost:9001

# Order gRPC service listen port. Defaults to GRPC_PORT if unset. Use a
# distinct port locally so catalog, cart, and order can all run. Suggested: 9002.
ORDER_GRPC_PORT=9002

# Order gRPC service address (default localhost:9002 — matches ORDER_GRPC_PORT).
ORDER_ADDR=localhost:9002
